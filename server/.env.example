# EGAN Clinic server configuration
# Copy to .env and adjust. Do NOT commit real secrets.

DATABASE_URL="file:./dev.db"

# Change this in every non-local environment.
JWT_SECRET="egan-clinic-dev-secret-change-me"
JWT_EXPIRES_IN="12h"
REFRESH_EXPIRES_IN="30d"

PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN="http://localhost:5173,http://localhost:4000"

# Local storage for uploaded documents and generated PDFs.
STORAGE_DIR="./data/storage"

# Public base URL used when generating share links / QR verification URLs.
PUBLIC_BASE_URL="http://localhost:5173"

# Optional integrations (leave blank to keep the feature in local/manual mode).
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
SMS_API_URL=""
SMS_API_TOKEN=""
EMAIL_SMTP_URL=""
PUSH_API_URL=""
PUSH_API_TOKEN=""

# Voice-to-text (optional). Without a provider the client uses the Web Speech API.
VOICE_STT_API_URL=""
VOICE_STT_API_KEY=""
